diff --git a/.github/workflows/pages.yml b/.github/workflows/pages.yml
index 2f92c90..12d7c72 100644
--- a/.github/workflows/pages.yml
+++ b/.github/workflows/pages.yml
@@ -28,6 +28,14 @@ jobs:
     steps:
       - uses: actions/checkout@v4
       - uses: actions/configure-pages@v5
+      # Pages lets a browser keep a script or stylesheet for ten minutes, so each
+      # deploy gives them a new URL, which a reload of the page fetches at once.
+      - name: Version the script and stylesheet
+        run: |
+          v=${GITHUB_SHA::7}
+          sed -E -i "s/(app\.js|styles\.css)\"/\1?v=$v\"/g" site/index.html
+          grep -F "app.js?v=$v\"" site/index.html
+          grep -F "styles.css?v=$v\"" site/index.html
       - uses: actions/upload-pages-artifact@v3
         with:
           path: site
